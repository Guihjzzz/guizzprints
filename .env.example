NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public Cloudflare Turnstile SITE key (not its secret). Configure the secret
# in Supabase Authentication > Attack Protection only after deploying this UI.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAE5VsYCC947Porp7

# Server-only: use a modern sb_secret_... key from Supabase. Do not expose it
# in the browser or commit it to Git. SUPABASE_SERVICE_ROLE_KEY is accepted
# only as a legacy fallback.
SUPABASE_SECRET_KEY=sb_secret_your-server-key

# Generate a different, random value with at least 32 characters for each environment.
DOWNLOAD_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Mercado Pago is the only payment provider (Checkout Transparente via Orders,
# PIX-only). Keep the Access Token server-only and scope each value to its
# Vercel environment.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_TEST_CHECKOUT_ENABLED=false
MERCADOPAGO_TEST_USER_IDS=
# Required for Sandbox Orders: use the e-mail of a Mercado Pago test buyer
# (it must end in @testuser.com). Never put a real secret in this file.
MERCADOPAGO_TEST_PAYER_EMAIL=
MERCADOPAGO_TEST_SITE_URL=
MERCADOPAGO_LIVE_CHECKOUT_ENABLED=false
MERCADOPAGO_SITE_URL=https://www.guizz.xyz
MERCADOPAGO_WEBHOOK_SECRET=

# Vercel Production cron authentication. Store a random value only in Vercel;
# never commit the real secret or put it in a browser-exposed variable.
CRON_SECRET=
