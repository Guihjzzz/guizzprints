NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Firebase Authentication (Guizz hololab). Values with NEXT_PUBLIC_ are the
# official web-app identifiers and may be exposed to browsers. Keep no private
# Firebase credential in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Comma-separated allowlist for the Firebase accounts permitted to access
# /admin, /upload and the Guizz Publisher. Do not add this to NEXT_PUBLIC_.
FIREBASE_ADMIN_EMAILS=junindacosta00241@gmail.com

# Public Cloudflare Turnstile SITE key (not its secret). Configure the secret
# in Supabase Authentication > Attack Protection only after deploying this UI.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAE5VsYCC947Porp7

# Optional server-only key for the legacy administrative routes. The Guizz
# Publisher and protected downloads use the Supabase Edge Function instead.
# Never expose this value in the browser or commit it to Git.
SUPABASE_SECRET_KEY=sb_secret_your-server-key

# Server-only GitHub token. Create a fine-grained token restricted to the
# guizzprints-assets repository with Contents: Read and write. It uploads the
# generated media and direct downloads to the current GitHub Release batch.
GITHUB_RELEASES_REPOSITORY=Guizzhjz/guizzprints-assets
GITHUB_RELEASES_TOKEN=github_pat_replace_with_a_server_only_token

# Generate a different, random value with at least 32 characters for each environment.
DOWNLOAD_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Vercel Production cron authentication. Store a random value only in Vercel;
# never commit the real secret or put it in a browser-exposed variable.
CRON_SECRET=
